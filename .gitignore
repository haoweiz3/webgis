# ---------- 依赖 ----------
node_modules/
.pnpm-store/

# ---------- 构建产物 ----------
dist/
dist-ssr/
build/
*.local

# ---------- 环境变量（.env.example 需要入库） ----------
.env
.env.*
!.env.example

# ---------- 编辑器与系统文件 ----------
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与缓存 ----------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vite/
.cache/
.eslintcache
*.tsbuildinfo

# ---------- 测试与覆盖率 ----------
coverage/
*.lcov

# ---------- 临时文件 ----------
*.tmp
*.bak
*.swp
*~

# ---------- 演示文稿构建中间产物（PPT 成品在 docs/答辩/） ----------
.codex-ppt-build/

# ---------- 图表工具临时目录（artifact-tool 生成的候选文件） ----------
.chart-data-*/

# ---------- 数据抓取缓存（可由 pnpm fetch:water 重新生成，不必入库） ----------
scripts/data-src/raw-osm-water.json
scripts/data-src/dem-tiles/
# FABDEM 原始下载（10°×10° 分块 zip / GeoTIFF，单文件可达 1 GB，不入库）
scripts/data-src/fabdem/
